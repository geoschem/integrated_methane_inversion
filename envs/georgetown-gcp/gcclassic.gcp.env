###############################################################################
# gcclassic.georgetown-hpc.env
#
# Environment file for GCClassic on Georgetown HPC (GCP-backed Slurm cluster).
#
# netcdf-c/netcdf-fortran/flex/HDF5 modules are self-built against the
# gcc/11.4.0 module. See/home/hn340/software/src/build_geoschem_deps.sh 
# for more information on how they were built.
###############################################################################

# Display message (if we are in a terminal window)
if [[ $- = *i* ]] ; then
  echo "Loading modules for GEOS-Chem Classic, please wait ..."
fi

#==============================================================================
# Unload all previously-loaded software
#==============================================================================
module purge

#==============================================================================
# Load Georgetown HPC modules needed for GEOS-Chem
#==============================================================================
module load gcc/11.4.0    # gcc / g++ / gfortran
module load cmake/4.1.1   # CMake (needed to compile)

#==============================================================================
# Self-built dependencies
#==============================================================================
GEOSCHEM_DEPS_ROOT="/home/hn340/software/geoschem-deps"

export HDF5_ROOT="${GEOSCHEM_DEPS_ROOT}/hdf5"
export NETCDF_C_ROOT="${GEOSCHEM_DEPS_ROOT}/netcdf-c"
export NETCDF_FORTRAN_ROOT="${GEOSCHEM_DEPS_ROOT}/netcdf-fortran"
export FLEX_HOME="${GEOSCHEM_DEPS_ROOT}/flex"
export BISON_HOME="${GEOSCHEM_DEPS_ROOT}/bison"

export PATH="${NETCDF_C_ROOT}/bin:${NETCDF_FORTRAN_ROOT}/bin:${FLEX_HOME}/bin:${BISON_HOME}/bin:${PATH}"
export LD_LIBRARY_PATH="${HDF5_ROOT}/lib:${NETCDF_C_ROOT}/lib:${NETCDF_FORTRAN_ROOT}/lib:${FLEX_HOME}/lib:${LD_LIBRARY_PATH}"

#==============================================================================
# Environment variables and related settings
# (mirrors envs/Harvard-Cannon/gcclassic.rocky+gnu12.minimal.env)
#==============================================================================

# Make all files world-readable by default
umask 022

# Set number of threads for OpenMP.  If running in a SLURM environment,
# use the number of requested cores.  Otherwise use 8 cores for OpenMP.
if [[ "x${SLURM_CPUS_PER_TASK:-}" == "x" ]]; then
    export OMP_NUM_THREADS=8
else
    export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
fi

# Max out the stacksize memory limit
export OMP_STACKSIZE="500m"

# Compilers
export CC="gcc"
export CXX="g++"
export FC="gfortran"
export F77="${FC}"

# netCDF (IMI/GEOS-Chem's build scripts look for NETCDF_HOME)
export NETCDF_HOME="${NETCDF_C_ROOT}"

# KPP 3.0.0+
export KPP_FLEX_LIB_DIR="${FLEX_HOME}/lib"

#==============================================================================
# Set limits
#==============================================================================

ulimit -c unlimited   # coredumpsize
ulimit -u 50000       # maxproc
ulimit -v unlimited   # vmemoryuse
ulimit -s unlimited   # stacksize

#==============================================================================
# Print information
#==============================================================================

module list

echo ""
echo "Environment:"
echo ""
echo "CC                  : ${CC}"
echo "CXX                 : ${CXX}"
echo "FC                  : ${FC}"
echo "KPP_FLEX_LIB_DIR    : ${KPP_FLEX_LIB_DIR}"
echo "NETCDF_HOME         : ${NETCDF_HOME}"
echo "NETCDF_C_ROOT       : ${NETCDF_C_ROOT}"
echo "NETCDF_FORTRAN_ROOT : ${NETCDF_FORTRAN_ROOT}"
echo "OMP_NUM_THREADS     : ${OMP_NUM_THREADS}"
echo ""
echo "Done sourcing ${BASH_SOURCE[0]}"
